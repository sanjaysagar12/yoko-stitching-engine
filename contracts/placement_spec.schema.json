{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "placement_spec.schema.json",
  "title": "Placement spec (what the user chose)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "placements"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "5: orient defaults to auto and pieces with a level line register on their body level unless anchor says otherwise"
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "piece",
          "point"
        ],
        "properties": {
          "piece": {
            "type": "string"
          },
          "point": {
            "type": "string"
          },
          "offset_m": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "rotation_deg": {
            "type": "number"
          },
          "mirror": {
            "type": "boolean"
          },
          "wrap": {
            "enum": [
              "flat",
              "roll",
              "around",
              "body_slice"
            ],
            "description": "flat, roll and around are isometric (sizes exact); body_slice distorts and needs arrange_options.allow_distortion"
          },
          "flip_facing": {
            "type": "boolean"
          },
          "reference": {
            "type": "string"
          },
          "ring": {
            "type": "string"
          },
          "layer": {
            "type": "integer",
            "minimum": 0
          },
          "locked": {
            "type": "boolean"
          },
          "shift_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "solved": {
            "description": "Parameters returned by an earlier answer: the piece stays exactly there (incremental align)",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "radius_m",
              "shift_m"
            ],
            "properties": {
              "radius_m": {
                "type": "number"
              },
              "shift_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "needed_radius_m": {
                "type": "number",
                "description": "the radius the piece needed when it was solved (body clearance, ring fit): carried so that its standoff keeps its reason"
              }
            }
          },
          "anchor": {
            "description": "limb pieces (roll/around on an arm or leg): where along the limb the piece sits. auto: root (cap/waist at the limb root) when the piece is longer than the point's volume or would reach into another body part, else point; point: the reference on the point; root: the top edge at the limb root; tip: the bottom edge at the wrist/ankle. An object registers the piece on a body level: {level, piece_point} puts that named piece point at the level height, {level, edge: top|bottom} the top/bottom of the outline, {edge} alone uses the point's height",
            "oneOf": [
              {
                "enum": [
                  "auto",
                  "point",
                  "root",
                  "tip"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "level": {
                    "enum": [
                      "Neck",
                      "Shoulder",
                      "Chest",
                      "Waist",
                      "Hip",
                      "Crotch",
                      "Knee",
                      "Ankle"
                    ]
                  },
                  "piece_point": {
                    "type": "string"
                  },
                  "edge": {
                    "enum": [
                      "top",
                      "bottom"
                    ]
                  },
                  "offset_m": {
                    "type": "number",
                    "description": "the registered point this far above the level (metres)"
                  }
                },
                "not": {
                  "required": [
                    "piece_point",
                    "edge"
                  ]
                }
              }
            ]
          },
          "orient": {
            "description": "in-plane orientation added to rotation_deg: auto (grainline, else long axis of a tall piece, parallel to the point's up / ring axis; default for schema_version 5), grain, none (default before 5) or a quarter turn",
            "oneOf": [
              {
                "enum": [
                  "auto",
                  "grain",
                  "none"
                ]
              },
              {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              }
            ]
          },
          "tilt": {
            "description": "rotate the placement frame (and a cylinder's axis) about the reference; pitch: top away from the body (+), roll: top toward the piece's +x (+); clamped to 45 degrees",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pitch_deg": {
                "type": "number"
              },
              "roll_deg": {
                "type": "number"
              }
            }
          },
          "over": {
            "description": "lay this piece over another placed piece (same point and wrap): its named point starts on the same named point of that piece, one layer out (pockets, plackets, interfacings)",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "piece",
              "point"
            ],
            "properties": {
              "piece": {
                "type": "string"
              },
              "point": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "stitches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b"
        ],
        "properties": {
          "a": {
            "$ref": "#/$defs/edge"
          },
          "b": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "rings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "pieces",
          "avatar_measurement"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pieces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "avatar_measurement": {
            "type": "string"
          },
          "include_clones": {
            "type": "boolean"
          },
          "level_point": {
            "type": "string"
          }
        }
      }
    },
    "derived_pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "source": {
            "type": "string"
          },
          "op": {
            "enum": [
              "mirror",
              "copy"
            ],
            "description": "mirror (default when absent): mirrored clone, needs axis; copy: exact copy, no axis"
          },
          "axis": {
            "$ref": "#/$defs/axis"
          }
        },
        "if": {
          "properties": {
            "op": {
              "const": "copy"
            }
          },
          "required": [
            "op"
          ]
        },
        "then": {
          "not": {
            "required": [
              "axis"
            ]
          }
        },
        "else": {
          "required": [
            "axis"
          ]
        }
      }
    },
    "arrange_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clearance_body": {
          "type": "number",
          "minimum": 0
        },
        "gap_piece": {
          "type": "number",
          "minimum": 0
        },
        "gap_layer": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_standoff": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_shift": {
          "type": "number",
          "minimum": 0
        },
        "refine_max_edge": {
          "type": "number",
          "exclusiveMinimum": 0.002
        },
        "standoff_mode": {
          "enum": [
            "uniform",
            "per_row"
          ],
          "description": "accepted for old specs; display only (the roll radius is the standoff)"
        },
        "incremental": {
          "type": "boolean"
        },
        "allow_distortion": {
          "type": "boolean"
        },
        "max_standoff_from_point": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "a piece farther than this from its point (beyond what its ring needs) is NOT_AT_POINT / STANDOFF_EXCEEDED"
        }
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "piece",
        "from_point",
        "to_point"
      ],
      "properties": {
        "piece": {
          "type": "string"
        },
        "from_point": {
          "type": "string"
        },
        "to_point": {
          "type": "string"
        }
      }
    },
    "axis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "bbox_center"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "from_point",
            "to_point"
          ],
          "properties": {
            "type": {
              "const": "edge"
            },
            "from_point": {
              "type": "string"
            },
            "to_point": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value_m"
          ],
          "properties": {
            "type": {
              "const": "x"
            },
            "value_m": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
